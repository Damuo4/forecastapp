# Optional: copy to .env to override. docker-compose.yml uses these same values as defaults.
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/appdb
VITE_PROXY_TARGET=http://backend:8000
WATCHFILES_FORCE_POLLING=true
CHOKIDAR_USEPOLLING=true
FRED_API_KEY=your_fred_api_key_here
COMTRADE_API_KEY=your_comtrade_api_key_here
COMTRADE_REPORTER_CODE=842
COMTRADE_PARTNER_CODE=0
COMTRADE_PERIODS=2023,2024,2025
SEC_USER_AGENT="Your App Name your_email@example.com"
SEC_BASE_URL="https://data.sec.gov"
